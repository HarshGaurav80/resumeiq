# Copy this file to `.env` and fill in at least one API key.
# With no key, ResumeIQ still works using the offline keyword + TF-IDF analyzer.

# Which AI provider to use: auto | gemini | openai | none
#   auto  -> Gemini if GEMINI_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else offline
AI_PROVIDER=auto

# Google Gemini (free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Seconds to wait for the AI before falling back to offline analysis
AI_TIMEOUT=60

# SQLite database file (relative to the backend folder)
DATABASE_PATH=data/resumeiq.db

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
